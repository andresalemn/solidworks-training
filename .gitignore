# === SolidWorks temp / lock / backup files ===
# SW lock files (created while a file is open)
~$*
*.~*
*.bak
*.old

# SolidWorks auto-recover / backup folders
*_backup/
SW_backup/

# SolidWorks journal & log files (session-specific, not useful in repo)
*.SLDLOG
*.log

# Design table temp files (if you use Excel-driven design tables)
~$*.xlsx
~$*.xls

# SolidWorks generated preview/thumbnail cache (regenerates automatically)
*.SLDPRT.thumb
*.SLDASM.thumb

# eDrawings temp exports (regenerate on demand, don't need version control)
*.eprt
*.edrw
*.easm

# === OS junk ===
.DS_Store
Thumbs.db
desktop.ini

# === Editor / tool junk ===
.vscode/
*.tmp

# === Large exports you may regenerate rather than store ===
# Uncomment if you don't want STEP/PDF exports tracked (they're derived files)
# *.STEP
# *.step
# *.pdf

# === Video files ===
# *.avi
# *.mp4
# *.mov

# ---------------------------------------------------
# Obsidian Vault Git Ignore Rules
# ---------------------------------------------------

# Ignore transient and device-specific state
.obsidian/graph.json
.obsidian/workspace.json
.obsidian/appearance.json

# ---------------------------------------------------
# Customizations and core settings
# ---------------------------------------------------

# Include only meaningful settings
!.obsidian/app.json
!.obsidian/themes/
!.obsidian/snippets/
!.obsidian/hotkeys.json
!.obsidian/workspaces.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json

# ---------------------------------------------------
# Plugin handling
# ---------------------------------------------------

# Ignore plugin code and style files
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/cache/
.obsidian/plugins/*/backups/
.obsidian/plugins/*/logs/
.obsidian/plugins/*/tmp/
.obsidian/plugins/*/obsidian_askpass.sh

# ---------------------------------------------------
# System files
# ---------------------------------------------------
.DS_Store
Thumbs.db